server {
    # NGINX escucha en el puerto 80 
    listen 80;

    # Si la URL empieza con /api/ (ej: http://tu-ip/api/colectivos)
    location /api/ {
        # La barra "/" al final de 3000/ hace que NGINX borre "/api" antes de pasarlo a Express.
        # Así Express recibe "/colectivos".
        proxy_pass http://backend:3000/;
        
        # Estas líneas le avisan a Express cuál era la IP y el dominio original del usuario
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Si la URL empieza con /auth/ (ej: http://tu-ip/auth/)
    location /auth/ {
        # Se lo pasa derecho al contenedor de Keycloak en su puerto interno 8080
        proxy_pass http://keycloak:8080/auth/;
        
        # Cabeceras obligatorias para que Keycloak sepa que está detrás de NGINX
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Aumentamos el tamaño del buffer porque los tokens JWT de Keycloak son grandes
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Para el futuro Frontend (cualquier URL que no sea /api ni /auth)
    location / {
        root /usr/share/nginx/html;
        index index.html;
        # Si entran a http://tu-ip/proyectos (pantalla de React), devuelve el index.html de React
        try_files $uri $uri/ /index.html;
    }
}