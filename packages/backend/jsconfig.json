{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js",
    "index.js"
  ]
}
