{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit test/services test/validations",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/int",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "seed": "node seeds/seed.js",
    "seed:volumen": "node seeds/seed.js --volumen",
    "types": "tsc -p jsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "lodash": "^4.18.1",
    "mongoose": "^9.11.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20.19.43",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "roots": [
      "<rootDir>/test"
    ],
    "globalSetup": "<rootDir>/test/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/test/setup/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/test/setup/env.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/models/**/*.js",
      "src/repositories/**/*.js",
      "src/controllers/**/*.js",
      "src/routes/**/*.js",
      "src/middlewares/**/*.js"
    ]
  }
}
