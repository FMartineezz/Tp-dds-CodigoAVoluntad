# Copiar como .env.local y ajustar. Vite solo expone las variables que empiezan con VITE_.

# Dirección del backend
VITE_API_URL=http://localhost:8000

# Cuentas con las que se entra en la demo (mientras no haya login real).
# Son ids fijos que crea el seed del backend (npm run seed / seed:volumen):
#   c00000000000000000000001 → colectivo «Colectivo Ambiental CABA»
#   a00000000000000000000005 → colaboradora «FullstackFer»
VITE_DEMO_COLECTIVO_ID=c00000000000000000000001
VITE_DEMO_COLABORADORA_ID=a00000000000000000000005

#HCaptcha siteKey 
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# API key de /estadisticas: tiene que ser igual a MI_API_KEY del backend. Con ella el front
# se saltea el límite de 5 pedidos cada 20 minutos (sin ella, al recargar varias veces da 429).
# OJO: queda visible en el JS que baja el navegador, no es un secreto.
VITE_API_APIKEY=
